{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "version": "0.1.0",
    "description": "__MSG_extensionDescription__",
    "default_locale": "ja",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*"
            ],
            "js": [
                "src/schema-diagnostics-core.js",
                "src/chat-read-core.js",
                "src/page-state-main.js"
            ],
            "world": "MAIN",
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*"
            ],
            "js": [
                "src/settings-core.js",
                "src/chat-read-core.js",
                "src/overlay-core.js",
                "src/youtube-chat.js"
            ],
            "world": "ISOLATED",
            "run_at": "document_idle"
        }
    ]
}
