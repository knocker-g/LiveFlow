{
    "manifest_version": 3,
    "name": "LiveFlow PoC",
    "version": "0.1.0",
    "description": "Read-only Proof of Concept for YouTube Live Chat on PC Web.",
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*"
            ],
            "js": [
                "src/chat-read-core.js",
                "src/page-state-main.js"
            ],
            "world": "MAIN",
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*"
            ],
            "js": [
                "src/chat-read-core.js",
                "src/overlay-core.js",
                "src/native-chat-layout-core.js",
                "src/native-chat-layout.js",
                "src/youtube-chat.js"
            ],
            "world": "ISOLATED",
            "run_at": "document_idle"
        }
    ]
}
